# Runtime image for the public oncology research demo API.
# Includes only the sanitized demo bundle, compound registry, and synthetic index.
# Never copies raw METABRIC, raw GCTX, or compact GCTX.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY application/packages/pipeline_core /app/packages/pipeline_core
RUN pip install --no-cache-dir -e /app/packages/pipeline_core

COPY application/apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -r /app/apps/api/requirements.txt

COPY application/apps/api/app /app/apps/api/app
COPY outputs/compound_registry /app/outputs/compound_registry
COPY outputs/copilot_artifacts/public_demo_bundle /app/outputs/copilot_artifacts/public_demo_bundle
COPY outputs/copilot_artifacts/synthetic_patients/index.json /app/outputs/copilot_artifacts/synthetic_patients/index.json

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PUBLIC_DEMO_MODE=true \
    ALLOW_CUSTOM_UPLOADS=false \
    DISABLE_API_DOCS=true \
    ARTIFACT_DIR=/app/outputs/copilot_artifacts \
    COMPOUND_REGISTRY_DIR=/app/outputs/compound_registry/v1 \
    PUBLIC_DEMO_BUNDLE_DIR=/app/outputs/copilot_artifacts/public_demo_bundle/v1 \
    SYNTHETIC_PATIENTS_DIR=/app/outputs/copilot_artifacts/synthetic_patients \
    COPILOT_DB_PATH=/var/data/copilot.db

WORKDIR /app/apps/api
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
