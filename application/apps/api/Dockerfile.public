# Runtime image for the public breast-cancer research panel API.
#
# Serves pre-computed payloads only. The pipeline that produced them — BayesPrism
# deconvolution, the clustering, the LINCS scoring — never runs here, so none of
# the raw inputs are copied in. See the repository-root .dockerignore.
#
# Built from the repository root, because pipeline_core and the API app live in
# separate sub-trees under application/.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY application/packages/pipeline_core /app/packages/pipeline_core
RUN pip install --no-cache-dir -e /app/packages/pipeline_core

# Runtime dependencies only. See the header of requirements-public.txt for why
# this is not the same file the local environment installs.
COPY application/apps/api/requirements-public.txt /app/apps/api/requirements-public.txt
RUN pip install --no-cache-dir -r /app/apps/api/requirements-public.txt

# The Paperclip literature SDK. It is installed by a script rather than listed as a
# requirement because the vendor's URL ends in `paperclip.whl`, a filename pip refuses
# to parse. The script downloads the same wheel and gives it the PEP 427 name its own
# metadata already declares. It never fails the build: if the vendor is unreachable,
# the literature panel says the SDK is unavailable and everything else still works.
COPY application/apps/api/scripts/install_paperclip.py /tmp/install_paperclip.py
RUN python /tmp/install_paperclip.py && rm -f /tmp/install_paperclip.py

# The application, including app/data/v3 — the cohort and the three held-out
# patient payloads the panel is built on (~39 MB).
COPY application/apps/api/app /app/apps/api/app

# `outputs/` is deliberately NOT copied. It is listed in .gitignore, so it does
# not exist in the cloned repository Render builds from, and `COPY outputs` fails
# the build outright with "/outputs: not found". Nothing here needs it: the v3
# panel serves app/data/v3, the compound registry was never generated, and
# `load_registry()` returns an empty frame rather than raising when it is absent.
# pipeline_core.config creates every directory below at import time.

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PUBLIC_DEMO_MODE=true \
    ALLOW_CUSTOM_UPLOADS=false \
    DISABLE_API_DOCS=true \
    OLLAMA_ENABLED=false \
    ARTIFACT_DIR=/app/outputs/copilot_artifacts \
    SYNTHETIC_PATIENTS_DIR=/app/outputs/copilot_artifacts/synthetic_patients \
    COMPOUND_REGISTRY_DIR=/app/outputs/compound_registry/v1 \
    COMPOUND_REVIEW_QUEUE_DIR=/app/outputs/compound_registry/review_queue \
    COPILOT_DB_PATH=/tmp/copilot.db

WORKDIR /app/apps/api
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
