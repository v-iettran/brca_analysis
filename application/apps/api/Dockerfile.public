# Runtime image for the public breast-cancer research panel API.
#
# Serves pre-computed payloads only. The pipeline that produced them — BayesPrism
# deconvolution, the clustering, the LINCS scoring — never runs here, so none of
# the raw inputs are copied in. See the repository-root .dockerignore.
#
# Built from the repository root, because it needs both application/ and outputs/.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY application/packages/pipeline_core /app/packages/pipeline_core
RUN pip install --no-cache-dir -e /app/packages/pipeline_core

COPY application/apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -r /app/apps/api/requirements.txt

# The application, including app/data/v3 — the cohort and the three held-out
# patient payloads the panel is built on (~39 MB).
COPY application/apps/api/app /app/apps/api/app

# Optional curated artifacts. `outputs/` is a single COPY so a missing
# sub-directory cannot fail the build: the previous version copied
# `public_demo_bundle` and `synthetic_patients/index.json` individually and
# broke, because those are v1 paths that no longer exist. The v3 panel does not
# read them, and `load_registry()` returns empty rather than raising when the
# compound registry is absent.
COPY outputs /app/outputs

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PUBLIC_DEMO_MODE=true \
    ALLOW_CUSTOM_UPLOADS=false \
    DISABLE_API_DOCS=true \
    OLLAMA_ENABLED=false \
    ARTIFACT_DIR=/app/outputs/copilot_artifacts \
    COMPOUND_REGISTRY_DIR=/app/outputs/compound_registry/v1 \
    COPILOT_DB_PATH=/tmp/copilot.db

WORKDIR /app/apps/api
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
